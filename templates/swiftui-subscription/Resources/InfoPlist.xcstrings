    "NSHealthShareUsageDescription" : {
      "comment" : "[module:health] Apple Health read permission",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "__DISPLAY_NAME__ liest deine Aktivität und dein Gewicht, damit dein Plan genau bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "__DISPLAY_NAME__ reads your activity and weight to keep your plan accurate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "__DISPLAY_NAME__ lee tu actividad y tu peso para mantener tu plan al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "__DISPLAY_NAME__ lit ton activité et ton poids pour garder ton plan précis."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O __DISPLAY_NAME__ lê sua atividade e seu peso para manter seu plano preciso."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "__DISPLAY_NAME__, planını doğru tutmak için aktiviteni ve kilonu okur."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "[module:health] Apple Health write permission",
